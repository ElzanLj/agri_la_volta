# Copia questo file in ".env" nella stessa cartella e inserisci le tue credenziali.
# GMAIL_APP_PASS NON è la password del tuo account Gmail: è una "App Password"
# dedicata, che generi da https://myaccount.google.com/apppasswords
# (richiede la verifica in due passaggi attiva sull'account).
GMAIL_USER=
GMAIL_APP_PASS=
