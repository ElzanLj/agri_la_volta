# Copia questo file in ".env" (stesso livello) e inserisci i tuoi valori reali.
# I valori si trovano su console.firebase.google.com > Impostazioni progetto > Le tue app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# URL del mini-server email (src/EmailStatus/EmailServer.js).
# In sviluppo di solito è questo, in produzione va sostituito con l'URL reale.
VITE_API_URL=http://localhost:3001
