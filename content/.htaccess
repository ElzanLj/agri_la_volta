# Nothing in this folder is meant to be served to the web (partial protection, see docs/OPERATIONS.md).
# It only helps when the web server reads .htaccess files: the real protection is a document root
# pointing at public/ and the HTTP check described in docs/RELEASE_GUIDE.md.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
