# Copy this file to ".env" in the project root (outside public/) and fill in real values.
# Never commit .env. On hosting that supports real environment variables, those take
# precedence over values in .env.

# --- Application ---------------------------------------------------------
# production | development
APP_ENV=production
# Show error details in the browser. Must be false in production.
APP_DEBUG=false
# Public base URL without trailing slash, e.g. https://agriturismolavolta.com
# Production: the canonical address, without trailing slash, e.g. https://www.agriturismolavolta.com
# (it must match the address people use: the forms check the request's Origin against it).
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Rome

# --- Database (MySQL / MariaDB) ------------------------------------------
# Use "db" with the local Docker setup, the hosting's MySQL host otherwise.
DB_HOST=db
DB_PORT=3306
DB_NAME=agriturismo
DB_USER=agriturismo
DB_PASSWORD=
# Local Docker only: MariaDB root password used to initialise the container.
DB_ROOT_PASSWORD=

# --- Email (SMTP) --------------------------------------------------------
# smtp  = real delivery through the SMTP server below (production)
# log   = development only: messages are written to storage/mail/ and NOT sent
#         (refused when APP_ENV=production)
MAIL_TRANSPORT=smtp
# Credentials are provided by the owner; keep them only here or in the hosting
# environment. With SMTP_HOST empty nothing is lost: e-mails wait in the queue
# (Admin > Email) until the settings are complete.
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (implicit TLS, port 465) | none (testing only)
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Seconds to wait for the SMTP server before giving up (the booking is already saved).
SMTP_TIMEOUT=10
MAIL_FROM_ADDRESS=info@agriturismolavolta.com
MAIL_FROM_NAME="Agriturismo La Volta"
# Recipient of new-request notifications.
MAIL_ADMIN_ADDRESS=info@agriturismolavolta.com

# --- WhatsApp ------------------------------------------------------------
# International format, digits only, no "+" (e.g. 39XXXXXXXXXX). Leave empty
# until the owner confirms the number.
WHATSAPP_NUMBER=
# Country code assumed for phone numbers typed without one (digits only). 39 = Italy.
WHATSAPP_DEFAULT_COUNTRY_CODE=39

# --- Public site -----------------------------------------------------------
# Contact details shown on the public pages. Each one appears only when filled in
# (nothing is invented). Leave empty until the owner confirms them.
PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_ADDRESS=
# Secret used to sign the public form tokens. If empty it is derived from the database
# credentials; set a long random value in production (e.g. `php -r "echo bin2hex(random_bytes(32));"`).
APP_SECRET=
# Seconds a visitor must take to fill in the customer-data step (anti-bot). 0 disables the check.
PUBLIC_FORM_MIN_SECONDS=3
# Strict-Transport-Security max-age in seconds, sent only when APP_URL starts with https:// (0 disables).
# Browsers will refuse plain HTTP for that long: enable HTTPS first.
HSTS_MAX_AGE=15552000
# Months after which finished stays lose their personal data when `php bin/privacy.php purge` runs.
# Leave empty until the owner decides the retention period.
DATA_RETENTION_MONTHS=
