Options -Indexes
# The app owns URL canonicalisation (no trailing slash); directories are not browsable.
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Existing files (CSS, JS, images) are served directly; everything else goes to the app.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Request bodies are small (the biggest field is a 2000-character note): refuse anything above 1 MB
# even when the client sends no Content-Length (chunked transfer).
LimitRequestBody 1048576

# Compression of text responses.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml image/svg+xml
</IfModule>

# Static assets: asset() adds the file's modification time to every URL (?v=...), so they can be
# cached for a long time and still refresh as soon as a file changes.
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    <FilesMatch "\.(css|svg|webp|avif|jpe?g|png|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
