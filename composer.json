{
    "name": "agriturismo-la-volta/site",
    "description": "Agriturismo La Volta website",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/prepare-db.php",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
