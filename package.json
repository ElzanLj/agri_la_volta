{
  "name": "agriturismo-la-volta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sito web dell'Agriturismo La Volta: presentazione, galleria, sistema di prenotazione con Firebase e invio email di conferma.",
  "scripts": {
    "dev": "vite",
    "server": "node src/EmailStatus/EmailServer.js",
    "dev:all": "concurrently -n web,mail -c blue,green \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase": "^10.12.2",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-datepicker": "^7.0.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.25.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0"
  }
}
